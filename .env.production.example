# ============================
# AdSight Production Environment
# ============================
# IMPORTANT: Thay đổi tất cả giá trị bên dưới trước khi deploy!

# App
APP_NAME=AdSight
APP_ENV=production
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING_64_CHARS
DEBUG=false

# PostgreSQL
POSTGRES_USER=adsight
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=adsight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://adsight:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/adsight

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_ADS_INDEX=ads

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=adsight-media
MINIO_USE_SSL=false

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_JWT_SECRET_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Meta Ad Library API
META_ACCESS_TOKEN=your-meta-access-token
META_API_VERSION=v19.0

# TikTok Creative Center
TIKTOK_API_BASE_URL=https://ads.tiktok.com/creative_radar_api/v1

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS (comma-separated origins)
CORS_ORIGINS_STR=http://localhost:8080

# Frontend (empty = same origin, Nginx handles routing)
VITE_API_BASE_URL=
