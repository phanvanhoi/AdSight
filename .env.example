# ============================
# Ad Spy Platform - Environment
# ============================

# App
APP_NAME=AdSpy
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true

# PostgreSQL
POSTGRES_USER=adspy
POSTGRES_PASSWORD=adspy_dev_password
POSTGRES_DB=adspy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://adspy:adspy_dev_password@postgres:5432/adspy

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_ADS_INDEX=ads

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=adspy-media
MINIO_USE_SSL=false

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Meta Ad Library API
META_ACCESS_TOKEN=your-meta-access-token
META_API_VERSION=v19.0

# TikTok Creative Center
TIKTOK_API_BASE_URL=https://ads.tiktok.com/creative_radar_api/v1

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend
VITE_API_BASE_URL=http://localhost:8000
